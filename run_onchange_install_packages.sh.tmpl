#!/bin/bash


# Git must be installed before running this script.


NODEJS="nodejs"
FD_FIND="fd"
UV="uv"
JAVA="java"
STARSHIP="starship"
TREE_SITTER="tree-sitter-cli"
SYNCTHING="syncthing"
SHELLCHECK="shellcheck"


### MacOS ###
{{- if eq .chezmoi.os "darwin" }}
# Xcode Command Line Tools and Homebrew must be installed before running this script.
# run: xcode-select --install
# run: /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

PKG_MAN="brew install"
NODEJS="node"
SYNCTHING=""
$PKG_MAN --cask alacritty lulu firefox betterdisplay easydict font-jetbrains-mono-nerd-font hyperkey iina keka localsend obsidian raycast visual-studio-code pearcleaner tailscale-app orbstack syncthing-app signal
xattr -d com.apple.quarantine /Applications/Alacritty.app  # Disable Gatekeeper


### openSUSE Tumbleweed ###
{{- else if eq .chezmoi.osRelease.id "opensuse-tumbleweed" }}
PKG_MAN="sudo zypper install -y"
JAVA="java-21-openjdk"
TREE_SITTER="tree-sitter"
SHELLCHECK="ShellCheck"
UV=""

sudo zypper refresh
sudo zypper dup

# vscode
sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc &&
echo -e "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\nautorefresh=1\ntype=rpm-md\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc" | sudo tee /etc/zypp/repos.d/vscode.repo > /dev/null

sudo zypper refresh
$PKG_MAN alacritty flatpak keyd ksshaskpass6 code gnome-disk-utility patterns-devel-base-devel_basis
sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# tailscale
curl -fsSL https://tailscale.com/install.sh | sh
sudo tailscale set --operator=$USER

sudo firewall-cmd --permanent --add-service=mdns
sudo firewall-cmd --permanent --add-service=ssh
sudo firewall-cmd --reload

# uv
curl -LsSf https://astral.sh/uv/install.sh | sh

sudo zypper refresh

### Debian/Ubuntu ###
{{- else if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") }}
sudo apt full-upgrade
PKG_MAN="sudo apt-get install -y"
$PKG_MAN curl build-essential fontconfig gpg 
FD_FIND="fd-find"
UV=""
JAVA="default-jdk"
STARSHIP=""

# uv
curl -LsSf https://astral.sh/uv/install.sh | sh

# yarn
curl -sS https://dl.yarnpkg.com/debian/pubkey.gpg | gpg --dearmor | sudo tee /etc/apt/keyrings/yarn-archive-keyring.gpg > /dev/null
echo "deb [signed-by=/etc/apt/keyrings/yarn-archive-keyring.gpg] https://dl.yarnpkg.com/debian/ stable main" | sudo tee /etc/apt/sources.list.d/yarn.list


# eza
sudo mkdir -p /etc/apt/keyrings
wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" | sudo tee /etc/apt/sources.list.d/gierens.list
sudo chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list

# starship
curl -sS https://starship.rs/install.sh | sh

sudo apt-get update

{{- end }}

$PKG_MAN curl fping hyperfine unzip tmux fish neovim ripgrep $FD_FIND bat eza fzf $UV fastfetch btop tealdeer $SYNCTHING $STARSHIP $NODEJS $TREE_SITTER mosh npm yarn $JAVA rsync $SHELLCHECK
git clone https://github.com/tmux-plugins/tpm ~/.config/tmux/plugins/tpm
curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install jorgebucaran/fisher

### Clean cache and post install scripts ###
{{- if eq .chezmoi.os "darwin" }}
rm -rf ~/Library/Caches/Homebrew/

{{- else if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") }}
sudo apt-get clean

{{- else if eq .chezmoi.osRelease.id "opensuse-tumbleweed" }}

flatpak update
sudo flatpak install -y flathub com.github.wwmm.easyeffects org.localsend.localsend_app md.obsidian.Obsidian
sudo zypper refresh
sudo zypper clean --all
sudo zypper refresh

{{- end }}

echo "End of chezmoi installation script." 
